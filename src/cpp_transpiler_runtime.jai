#if CPU == .X64 {
c_transpiler_simd_scaled_box_distance_store_ref_f32x4 :: inline (
    destination: *[4] float32,
    scale: *[4] float32,
    point: *[4] float32,
    min_x: *[4] float32, min_y: *[4] float32, min_z: *[4] float32,
    max_x: *[4] float32, max_y: *[4] float32, max_z: *[4] float32,
) #no_context {
    #asm SSE {
        movups.x scale_value:, [scale];
        movups.x point_value:, [point];
        movaps.x factor:, scale_value;
        shufps factor, factor, 0x00;
        movups.x lower:, [min_x];
        movups.x upper:, [max_x];
        mulps.x lower, factor;
        mulps.x upper, factor;
        movaps.x minimum:, lower;
        minps.x minimum, upper;
        maxps.x lower, upper;
        movaps.x point_axis:, point_value;
        shufps point_axis, point_axis, 0x00;
        movaps.x distance:, point_axis;
        maxps.x distance, minimum;
        minps.x distance, lower;
        subps.x distance, point_axis;
        mulps.x distance, distance;

        movaps.x factor, scale_value;
        shufps factor, factor, 0x55;
        movups.x lower, [min_y];
        movups.x upper, [max_y];
        mulps.x lower, factor;
        mulps.x upper, factor;
        movaps.x minimum, lower;
        minps.x minimum, upper;
        maxps.x lower, upper;
        movaps.x point_axis, point_value;
        shufps point_axis, point_axis, 0x55;
        movaps.x axis_distance:, point_axis;
        maxps.x axis_distance, minimum;
        minps.x axis_distance, lower;
        subps.x axis_distance, point_axis;
        mulps.x axis_distance, axis_distance;
        addps.x distance, axis_distance;

        movaps.x factor, scale_value;
        shufps factor, factor, 0xaa;
        movups.x lower, [min_z];
        movups.x upper, [max_z];
        mulps.x lower, factor;
        mulps.x upper, factor;
        movaps.x minimum, lower;
        minps.x minimum, upper;
        maxps.x lower, upper;
        movaps.x point_axis, point_value;
        shufps point_axis, point_axis, 0xaa;
        movaps.x axis_distance, point_axis;
        maxps.x axis_distance, minimum;
        minps.x axis_distance, lower;
        subps.x axis_distance, point_axis;
        mulps.x axis_distance, axis_distance;
        addps.x distance, axis_distance;
        movups.x [destination], distance;
    }
}
}
